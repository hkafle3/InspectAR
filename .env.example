# Copy this file to .env and fill in your values. Never commit .env.

# Which AI turns notes into report entries:
#   mock      = free, no AI, works offline (default)
#   ollama    = free, a local model on this laptop (install the Ollama app first)
#   anthropic = Claude API, needs ANTHROPIC_API_KEY (costs money per capture)
AI_MODE=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional, only for transcribing audio with OpenAI (costs money). Free local
# transcription (faster-whisper) is used otherwise.
OPENAI_API_KEY=
OLLAMA_MODEL=qwen2.5vl:3b

# Report header
PROPERTY_ADDRESS=123 Example St, Brooklyn, NY
INSPECTOR_NAME=
